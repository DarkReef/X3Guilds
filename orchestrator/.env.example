# mock = deterministic local test mode; gigachat = real API
X3AI_PROVIDER=mock

# GigaChat authorization key from the developer cabinet (Base64 client_id:client_secret)
X3AI_GIGACHAT_CREDENTIALS=
X3AI_GIGACHAT_SCOPE=GIGACHAT_API_PERS
X3AI_GIGACHAT_MODEL=GigaChat-2
X3AI_GIGACHAT_BASE_URL=https://api.giga.chat
X3AI_GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
X3AI_GIGACHAT_VERIFY_SSL=true
X3AI_GIGACHAT_TIMEOUT_SECONDS=45
X3AI_GIGACHAT_RETRIES=2

# Leave empty for auto-detection: %USERPROFILE%\Documents\Egosoft\X3FL\log09980.txt
X3AI_REQUEST_LOG_PATH=
X3AI_RESPONSE_LOG_PATH=./data/x3guilds-ai-responses.log
X3AI_CHECKPOINT_PATH=./data/x3guilds-ai.checkpoint.json
X3AI_DATABASE_PATH=./data/x3guilds-ai.sqlite3
X3AI_DIAGNOSTICS_PATH=./data/diagnostics
X3AI_POLL_INTERVAL_MS=350

X3AI_OVERLAY_ENABLED=true
X3AI_OVERLAY_ALWAYS_ON_TOP=true
X3AI_OVERLAY_WIDTH=620
X3AI_OVERLAY_HEIGHT=420
X3AI_HISTORY_LIMIT=12
X3AI_MEMORY_LIMIT=20
